        <mxCell id="UnUAPrTQPNjwvzDrpRdy-27" parent="1" style="text;html=1;align=center;fontSize=11;fontColor=#333333;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Legend: blue = prefix (system prompt + instructions) · light gray = haystack with distractor activation-code records · purple = suffix (generation trigger) · red / blue / green pins = target needle code placed at 10% / 50% / 90% depth&lt;/font&gt;" vertex="1">
