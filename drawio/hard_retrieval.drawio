        <mxCell id="UnUAPrTQPNjwvzDrpRdy-28" parent="1" style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#777777;" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;Frozen benchmark: 60 scenarios per configuration = 20 scenarios per depth · exact 4,096-token tokenizer-specific document · retrieval and format correctness scored separately (Section&amp;nbsp;5)&lt;/font&gt;" vertex="1">
