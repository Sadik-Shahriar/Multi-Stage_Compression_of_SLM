<mxfile host="app.diagrams.net" agent="opencode" version="24.7.0">
  <diagram id="pyramidal-gqa" name="Eviction &amp; GQA Schematic">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="L" value="Pyramidal eviction budget — per-layer retained tokens (mean 1,024 / layer)" style="swimlane;startSize=24;fillColor=#f3f3f3;strokeColor=#808080;html=1;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="560" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;Early layers&lt;/b&gt;&lt;br&gt;keep up to ~1,966 tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L">
          <mxGeometry x="90" y="44" width="380" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;Layers ~8–14&lt;/b&gt;&lt;br&gt;≈ 1,450 tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5dcf9;strokeColor=#6c8ebf;" vertex="1" parent="L">
          <mxGeometry x="130" y="136" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;Layers ~15–21&lt;/b&gt;&lt;br&gt;≈ 1,030 tokens · ≈ mean 1,024" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a9cbf5;strokeColor=#6c8ebf;" vertex="1" parent="L">
          <mxGeometry x="170" y="228" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;Deep layers&lt;/b&gt;&lt;br&gt;keep only ~82 tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8fb5ea;strokeColor=#6c8ebf;" vertex="1" parent="L">
          <mxGeometry x="210" y="320" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="L" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="L" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="L" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="Lnote" value="Dropped tokens are freed from the KV cache after prefill. The deeper the layer, the tighter the budget — a funnel of persistence: generous retention in shallow layers, aggressive compression in deep ones." style="text;html=1;align=center;fontSize=11;fontColor=#333333;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;rounded=1;whiteSpace=wrap;" vertex="1" parent="L">
          <mxGeometry x="20" y="430" width="520" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="Lavg" value="avg budget = 1,024 tokens / layer" style="text;html=1;align=center;fontSize=12;fontStyle=4;fontColor=#6c8ebf;" vertex="1" parent="L">
          <mxGeometry x="20" y="536" width="520" height="22" as="geometry"/>
        </mxCell>

