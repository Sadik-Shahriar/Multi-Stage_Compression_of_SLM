        <mxCell id="Wlbl" value="8 query heads → 1 KV head&lt;br&gt;(16 Q / 2 KV total)&lt;br&gt;Evicting one KV head strips attention&lt;br&gt;from ALL 8 query heads — catastrophic" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#7f4f00;" vertex="1" parent="QW">
          <mxGeometry x="30" y="286" width="340" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="warn" value="!" style="shape=triangle;direction=north;html=1;fillColor=#ffcc00;strokeColor=#b00000;fontColor=#b00000;fontStyle=1;fontSize=16;rotatable=0;" vertex="1" parent="QW">
