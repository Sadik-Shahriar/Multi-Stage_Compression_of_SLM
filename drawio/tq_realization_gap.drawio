<mxfile host="app.diagrams.net" agent="opencode" version="24.7.0">
  <diagram id="tq-realization-gap" name="TurboQuant Realization Gap">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="TurboQuant storage realization gap &#8212; identical 4-bit numerics, three different memory realities" style="text;html=1;align=center;fontSize=15;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1320" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="pan1" value="&lt;b&gt;1 &#xb7; Matched FP16 baseline&lt;/b&gt;" style="rounded=0;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontStyle=1;fontSize=12;whiteSpace=wrap;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="380" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="b1mem" value="&lt;b&gt;FP16 Keys &amp; Values&lt;/b&gt;&lt;br&gt;full precision, nothing compressed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="pan1">
          <mxGeometry x="40" y="70" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="b1note" value="Measured Llama decode cache:&lt;br&gt;&lt;b&gt;455.0 MiB&lt;/b&gt;&lt;br&gt;(&#8595; 146.2 MiB for Qwen)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;fillColor=#ffffff;strokeColor=#cccccc;rounded=1;whiteSpace=wrap;" vertex="1" parent="pan1">
          <mxGeometry x="40" y="212" width="300" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="b1arrow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=1;dashed=1;" edge="1" parent="pan1" source="b1mem" target="b1note">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="pan2" value="&lt;b&gt;2 &#xb7; Realized TQ-Ref path (what we measured)&lt;/b&gt;" style="rounded=1;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;html=1;fontStyle=1;fontSize=12;whiteSpace=wrap;spacingTop=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="480" y="90" width="440" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="b2a" value="&lt;b&gt;uint8 Indices&lt;/b&gt;&lt;br&gt;1 byte per coordinate (nominal 4-bit, physically 8-bit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9b3;strokeColor=#b85450;" vertex="1" parent="pan2">
          <mxGeometry x="30" y="56" width="380" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="b2b" value="&lt;b&gt;FP32 Norms / Scales&lt;/b&gt;&lt;br&gt;per-token scaling state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9b3;strokeColor=#b85450;" vertex="1" parent="pan2">
          <mxGeometry x="30" y="142" width="380" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="b2c" value="&lt;b&gt;Materialized FP16 Key/Value tensors&lt;/b&gt;&lt;br&gt;full-resolution originals kept resident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffbf97;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="pan2">
          <mxGeometry x="30" y="216" width="380" height="94" as="geometry"/>
        </mxCell>
        <mxCell id="b2warn" value="&#9888; The uncompressed FP16 copies are STILL in memory &#8212; that is why this box is the biggest." style="text;html=1;align=center;fontSize=11;fontColor=#9a2b1f;fontStyle=2;fillColor=#ffffff;strokeColor=#b85450;rounded=1;whiteSpace=wrap;" vertex="1" parent="pan2">
          <mxGeometry x="30" y="322" width="380" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="b2note" value="Measured decode cache:&lt;b&gt;696.5 MiB&lt;/b&gt; (Llama) &#183; &lt;b&gt;223.9 MiB&lt;/b&gt; (Qwen)&lt;br&gt;&#8776; 153% of matched FP16 &#8212; &lt;b&gt;larger, not smaller&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7c4a00;fillColor=#ffffff;strokeColor=#d79b00;rounded=1;whiteSpace=wrap;" vertex="1" parent="pan2">
          <mxGeometry x="30" y="372" width="380" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="pan3" value="&lt;b&gt;3 &#xb7; Ideal packed/fused (theor. limit)&lt;/b&gt;" style="rounded=1;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;html=1;fontStyle=1;fontSize=12;whiteSpace=wrap;spacingTop=8;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="90" width="360" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="b3a" value="&lt;b&gt;Packed 4-bit Indices&lt;/b&gt;&lt;br&gt;(physically packed, not uint8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdbb4;strokeColor=#5e8f5a;" vertex="1" parent="pan3">
          <mxGeometry x="25" y="44" width="310" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="b3b" value="&lt;b&gt;FP32 Norms&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c9e7c3;strokeColor=#5e8f5a;" vertex="1" parent="pan3">
          <mxGeometry x="25" y="118" width="310" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="b3c" value="&lt;b&gt;128-token FP16 Residual&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c9e7c3;strokeColor=#5e8f5a;" vertex="1" parent="pan3">
          <mxGeometry x="25" y="168" width="310" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="b3note" value="Decode cache:&lt;b&gt;131.1 MiB&lt;/b&gt; (Llama) &#183; &lt;b&gt;42.2 MiB&lt;/b&gt; (Qwen)&lt;br&gt;&#8776; 28.8% of matched FP16 (TQ-only) &#183; 35.2% (compound)&lt;br&gt;&lt;i&gt;theoretical estimate, never measured&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#2e5e2c;fillColor=#ffffff;strokeColor=#66b24d;rounded=1;whiteSpace=wrap;" vertex="1" parent="pan3">
          <mxGeometry x="25" y="224" width="310" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="TAKE" value="&lt;b&gt;Key takeaway:&lt;/b&gt; TQ-Ref is numerically 4-bit but physically &lt;b&gt;larger&lt;/b&gt; than the FP16 baseline (uint8 indices + materialized originals). Only a hypothetical packed/fused kernel unlocks the theoretical &#8776;29&#8211;35% footprint &#8212; the gap between what was measured and what an ideal implementation could achieve." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9b3;strokeColor=#b85450;fontColor=#7c2a1f;fontSize=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1320" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e12" value="&lt;font size=&quot;2&quot; color=&quot;#d79b00&quot;&gt;&lt;b&gt;+53% larger&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;exitX=1;exitY=0.5;" edge="1" parent="1" source="pan1" target="pan2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e23" value="&lt;font size=&quot;2&quot; color=&quot;#2e5e2c&quot;&gt;&lt;b&gt;&#8776;81% smaller&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="pan2" target="pan3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>