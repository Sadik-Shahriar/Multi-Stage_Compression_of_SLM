  <diagram id="methodology" name="Methodology">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="setup" value="&#xa;1 &#xb7; Experimental Setup" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#a0a0a0;html=1;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1240" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="hw" value="NVIDIA T4 &lt;br&gt;16 GB VRAM &#xb7; 70 W enforced cap &lt;br&gt;10 Hz pynvml power polling &lt;br&gt;Google Colab (free tier)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a0a0a0;" vertex="1" parent="setup">
          <mxGeometry x="20" y="36" width="240" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="llama2" value="&lt;b&gt;Llama 3.2-3B-Instruct&lt;/b&gt;&lt;br&gt;28 layers &#183; 24 Q / 8 KV heads (3:1 GQA)&lt;br&gt;FP16: unsloth &#183; AWQ: casperhansen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="setup">
          <mxGeometry x="280" y="36" width="250" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="qwen2" value="&lt;b&gt;Qwen2.5-3B-Instruct&lt;/b&gt;&lt;br&gt;36 layers &#183; 16 Q / 2 KV heads (8:1 GQA)&lt;br&gt;pinned FP16 + AWQ model revisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="setup">
          <mxGeometry x="560" y="36" width="250" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="stack" value="&lt;b&gt;Compression components&lt;/b&gt;&lt;br&gt;AWQ 4-bit (group size 128) &#183; custom PyramidKV-style&lt;br&gt;scorer (avg budget 1024) &#183; turboquant==0.2.0 (TQ-Ref)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="setup">
          <mxGeometry x="840" y="36" width="340" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="seed" value="Fixed seed 407 &#183; explicit schemas, fingerprints, manifests, frozen prompt hashes" style="text;html=1;align=center;fontSize=11;fontColor=#666666;" vertex="1" parent="setup">
          <mxGeometry x="20" y="122" width="1160" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="cfg" value="2 &#183; Configurations (Llama C-labels / Qwen Q-labels)" style="swimlane;startSize=24;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="1240" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="craw" value="&lt;b&gt;C0 / Q0&lt;/b&gt;&lt;br&gt;FP16 baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="cfg">
          <mxGeometry x="20" y="36" width="150" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="cawq" value="&lt;b&gt;C1 / Q1-W&lt;/b&gt;&lt;br&gt;AWQ 4-bit &lt;br&gt;(matched wrapper)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e3fc;strokeColor=#6c8ebf;" vertex="1" parent="cfg">
          <mxGeometry x="190" y="36" width="150" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="cev" value="&lt;b&gt;C2 / Q2&lt;/b&gt;&lt;br&gt;+ eviction (PyramidKV-style,&lt;br&gt;layerwise budget avg 1024)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e3fc;strokeColor=#6c8ebf;" vertex="1" parent="cfg">
          <mxGeometry x="360" y="36" width="180" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="ctq" value="&lt;b&gt;C3-Ref / Q3-Ref&lt;/b&gt;&lt;br&gt;+ TQ-Ref numerical path &lt;br&gt;(turboquant==0.2.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e3fc;strokeColor=#6c8ebf;" vertex="1" parent="cfg">
          <mxGeometry x="560" y="36" width="180" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;C4-Ref / Q4-Ref&lt;/b&gt;&lt;br&gt;sequential compound&lt;br&gt;eviction then TQ-Ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9d9;strokeColor=#b85450;" vertex="1" parent="cfg">
          <mxGeometry x="760" y="36" width="200" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="cfgnote" value="&lt;i&gt;Note:&lt;/i&gt; C2/C3/C4 = AWQ-based; C0/Q0 FP16. TQ-Ref numerically active but &lt;b&gt;unfused&lt;/b&gt;: uint8 indices, retained materialized K/V, FP32 norms, 128-token FP16 residual. An ideal packed/fused realization is analyzed separately as a conditional projection (never measured)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;fillColor=#f4f7ff;strokeColor=#b0c4de;" vertex="1" parent="cfg">
          <mxGeometry x="20" y="104" width="1180" height="52" as="geometry"/>
