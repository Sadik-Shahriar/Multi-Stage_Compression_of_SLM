        <mxCell id="meas" value="3 &#183; Measurement Protocol" style="swimlane;startSize=24;fillColor=#d5e8d4;strokeColor=#82b366;html=1;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="800" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="&lt;b&gt;Power &amp; energy&lt;/b&gt;&lt;br&gt;pynvml 10 Hz &#8594; trapezoidal integration (max err &#8804;1.1e-13 J)&lt;br&gt;phase-separated prefill / decode &#183; contexts 1024 &#183; 2048 &#183; 4096" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0d0;strokeColor=#82b366;" vertex="1" parent="meas">
          <mxGeometry x="20" y="36" width="480" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;Quality&lt;/b&gt;: frozen exact-4096-token hard-retrieval &lt;br&gt;60 scenarios / config &#183; depth bins 10% &#183; 50% &#183; 90% &lt;br&gt;exact success, format, target NLL, first-token diagnostics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0d0;strokeColor=#82b366;" vertex="1" parent="meas">
          <mxGeometry x="20" y="108" width="480" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;Memory&lt;/b&gt;: persistent cache (MiB), analytical FP bytes,&lt;br&gt;TQ index/norm/residual storage &#183; peak VRAM (MiB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0d0;strokeColor=#82b366;" vertex="1" parent="meas">
          <mxGeometry x="20" y="180" width="480" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="&lt;b&gt;Throughput&lt;/b&gt;: decode tokens/s &#183; per-phase runtime;&lt;br&gt;workload = fixed 64-token teacher-forced decode &#183; 5 blocks/path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0d0;strokeColor=#82b366;" vertex="1" parent="meas">
          <mxGeometry x="20" y="244" width="480" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="measnote" value="Fail-closed gate: wrappers validated for logit parity (zero diff) before measurement." style="text;html=1;align=center;fontSize=11;fontColor=#555555;verticalAlign=middle;" vertex="1" parent="meas">
          <mxGeometry x="520" y="60" width="250" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="pipe" value="&#183; Experiment Pipeline&#xa; (numbered Colab notebooks, Track A)" style="swimlane;startSize=24;fillColor=#fff2cc;strokeColor=#d6b656;html=1;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="880" y="430" width="400" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;A0 (NB 00)&lt;/b&gt;: verify historical Llama v5 evidence (380 rows, 95 traces)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;" vertex="1" parent="pipe">
