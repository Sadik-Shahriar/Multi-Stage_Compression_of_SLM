        <mxCell id="ana" value="4 &#183; Statistical Analysis and Validation" style="swimlane;startSize=24;fillColor=#ffe6cc;strokeColor=#d79b00;html=1;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1240" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Registered paired tests&lt;/b&gt;: paired t-test / Wilcoxon (n=5 blocks)&lt;br&gt;McNemar exact (60 scenarios) + Bonferroni (quality family)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b3;strokeColor=#d79b00;" vertex="1" parent="ana">
          <mxGeometry x="20" y="36" width="590" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Sequential interaction&lt;/b&gt;: I = (C4&#8722;C3) &#8722; (C2&#8722;C1)&lt;br&gt;energy / decode time / throughput; Holm-adjusted familywise control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b3;strokeColor=#d79b00;" vertex="1" parent="ana">
          <mxGeometry x="630" y="36" width="590" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Robustness&lt;/b&gt;: same raw traces re-integrated with samples &gt; 82 W / 70 W clipped;&lt;br&gt;rankings and registered significance decisions tracked (all stable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b3;strokeColor=#d79b00;" vertex="1" parent="ana">
          <mxGeometry x="20" y="108" width="590" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Uncertainty&lt;/b&gt;: Wilson 95% intervals (n=60 / n=15) &#183; effect sizes &#183;&lt;br&gt;depth-stratified bootstrap &#183; 2000-sample Pareto frontier stability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b3;strokeColor=#d79b00;" vertex="1" parent="ana">
          <mxGeometry x="630" y="108" width="590" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;Fail-closed evidence gates&lt;/b&gt;: schema + fingerprint + artifact-manifest SHA-256 &#183; unique-key gates &#183; source re-hash &#183; raw-trace reintegration &#8804; 1.1e-13 J &#183; accepted / provisional / discarded bundles never mutated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9b3;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="ana">
          <mxGeometry x="20" y="180" width="1200" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="anaout" value="Evidence tiers: accepted measured &#183; accepted derived &#183; provisional synthesis &#183; ideal projection" style="text;html=1;align=center;fontSize=12;fontColor=#333333;" vertex="1" parent="ana">
          <mxGeometry x="20" y="236" width="1200" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="out" value="5 &#183; Outputs and Claims" style="swimlane;startSize=24;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1180" width="1240" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;Energy outcomes&lt;/b&gt;: ranking vs context; decode/prefill split;&lt;br&gt;C2 &lt; C1 at 4096 (Llama sig.); TQ-Ref adds ~45% / 31% energy (reference path only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee0f5;strokeColor=#9673a3;" vertex="1" parent="out">
          <mxGeometry x="20" y="36" width="380" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;Quality outcomes&lt;/b&gt;: hard retrieval + Wilson intervals;&lt;br&gt;eviction model-dependent (Llama ~neutral / Qwen near-zero); TQ-Ref preserves quality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee0f5;strokeColor=#9673a3;" vertex="1" parent="out">
          <mxGeometry x="420" y="36" width="400" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="o3" value="&lt;b&gt;Multi-objective view&lt;/b&gt;: Pareto frontier (joules &#215; retrieval &#215; persistent MiB)&lt;br&gt;+ bootstrap stability; explicit minimum-quality constraint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee0f5;strokeColor=#9673a3;" vertex="1" parent="out">
          <mxGeometry x="840" y="36" width="380" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="o4" value="&lt;b&gt;Ideal-projection caveats (claims)&lt;/b&gt;: storage envelope 28.8% FP (TQ-only) / 35.2% FP (compound);&lt;br&gt;symbolic break-even O&#7534; &lt; &#949;&#183;&#8706;D &#8212; no numeric ideal joules / throughput / VRAM claimed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee0f5;strokeColor=#9673a3;" vertex="1" parent="out">
          <mxGeometry x="20" y="116" width="1200" height="66" as="geometry"/>
